# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/jalemos_db"

# Servidor
PORT=4000
NODE_ENV=development

# Dominios que pueden llamar a esta API, separados por coma
ORIGENES_PERMITIDOS="http://localhost:5173"

# Seguridad — genera un valor real con: openssl rand -hex 32
# NUNCA subas el .env real (con el secreto verdadero) a git.
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres"

# API de pagos (se completa en la fase de integración de pagos)
PAGOS_API_KEY=""
PAGOS_API_URL=""

# Correo (para el envío de tickets)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="jalemos.com <no-responder@jalemos.com>"
